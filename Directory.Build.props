<Project>
  <!--
    src/Shared 是 MVC 与 WebApi 两个包的共享源码。
    两个工程分别引用 NewLife.Cube.Core / NewLife.Cube，程序集名都是 NewLife.Cube.QyWeixin。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- net6.0 已停止官方支持，仍保留兼容目标，不在构建时输出 EOL 警告 -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**;**/nupkg/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
